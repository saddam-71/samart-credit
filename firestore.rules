rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /merchants/{merchantId}/customers/{customerId} {
      allow read, write: if request.auth != null;
    }
    match /merchants/{merchantId}/transactions/{transactionId} {
      allow read, write: if request.auth != null;
    }
    match /merchants/{merchantId}/backup_metadata/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
